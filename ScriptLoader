local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer or Players.PlayerAdded:Wait()

local SupportedGames = {
    [142823291] = "https://raw.githubusercontent.com/XperienceER/XERHUB/refs/heads/main/mm2.lua", -- Murder Mystery 2
    -- [PlaceID_อื่น] = "URL_สคริปต์_อื่น",
}

local currentPlaceId = game.PlaceId
local scriptUrl = SupportedGames[currentPlaceId]

if scriptUrl then
    local success, result = pcall(function()
        return loadstring(game:HttpGet(scriptUrl))()
    end)
    
    if not success then
        warn("เกิดข้อผิดพลาดในการรันสคริปต์: " .. tostring(result))
    end
else
    LocalPlayer:Kick("ไม่รองรับแมพนี้ (Place ID: " .. tostring(currentPlaceId) .. ")")
end
